FLASK_HOST=127.0.0.1
FLASK_PORT=5000
API_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
MODEL_ARTIFACT_DIR=./model_artifacts
# Optional PostgreSQL/Supabase connection URL; never commit a populated value.
DATABASE_URL=
DATABASE_CONNECT_TIMEOUT_SECONDS=3
# Optional: add an approved Nigeria Health Facility Registry API key here.
HFR_API_KEY=
# Optional backend-only Supabase Auth verification configuration.
# Use a public anon/publishable key; never use a service-role key or JWT signing secret.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
SUPABASE_AUTH_TIMEOUT_SECONDS=3